# Valores FICTICIOS. Copia este archivo a .env y ajústalo. Nunca subas .env.
PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=fleetcore

# JWT
JWT_SECRET=cambia-este-secreto
JWT_EXPIRES_IN=1h

# Claves para integraciones externas (x-api-key), separadas por comas
API_KEYS=demo-key-partner-1,demo-key-partner-2
